[tools."github:atuinsh/atuin"]
# Upstream Linux glibc releases require GLIBC 2.38+; use musl assets for compatibility across Linux distributions.
version = "latest" # Magical shell history replacement database

[tools."github:atuinsh/atuin".platforms]
linux-x64 = { asset_pattern = "*x86_64-unknown-linux-musl*" }
linux-arm64 = { asset_pattern = "*aarch64-unknown-linux-musl*" }
macos-x64 = { asset_pattern = "*x86_64-apple-darwin*" }
macos-arm64 = { asset_pattern = "*aarch64-apple-darwin*" }

[tools."github:googleworkspace/cli"]
# Retested 2026-09-02: the earlier "0.22.5 needs GLIBC 2.39" pin does not reproduce.
# That asset is static-pie with no INTERP segment and zero GLIBC_ symbols, and runs on
# this host's glibc 2.36. The platform patterns below stay, since upstream ships glibc
# and musl x64 tarballs side by side and the musl one is the portable choice.
version = "latest" # Google Workspace CLI (gws)

[tools."github:googleworkspace/cli".platforms]
linux-x64 = { asset_pattern = "*x86_64-unknown-linux-musl*" }
linux-arm64 = { asset_pattern = "*aarch64-unknown-linux-musl*" }
macos-x64 = { asset_pattern = "*x86_64-apple-darwin*" }
macos-arm64 = { asset_pattern = "*aarch64-apple-darwin*" }

[tools."github:tailwindlabs/tailwindcss"]
# Upstream ships glibc and musl assets side by side on Linux; name them explicitly so a
# rename upstream cannot silently flip which one is selected.
version = "latest" # Standalone Tailwind CSS v4 compiler (GOTH assets, no Node.js)

[tools."github:tailwindlabs/tailwindcss".platforms]
linux-x64 = { asset_pattern = "tailwindcss-linux-x64-musl" }
linux-arm64 = { asset_pattern = "tailwindcss-linux-arm64-musl" }
macos-x64 = { asset_pattern = "tailwindcss-macos-x64" }
macos-arm64 = { asset_pattern = "tailwindcss-macos-arm64" }

[tools."github:sxyazi/yazi"]
# Upstream GNU/Linux releases require GLIBC 2.39; select the same-version musl
# asset so the latest release remains portable to Debian 12.
version = "latest" # Blazing-fast terminal file manager in Rust

[tools."github:sxyazi/yazi".platforms]
linux-x64 = { asset_pattern = "*x86_64-unknown-linux-musl.zip" }
linux-arm64 = { asset_pattern = "*aarch64-unknown-linux-musl.zip" }
macos-x64 = { asset_pattern = "*x86_64-apple-darwin.zip" }
macos-arm64 = { asset_pattern = "*aarch64-apple-darwin.zip" }
