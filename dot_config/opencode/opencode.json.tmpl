{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "model": "google-vertex/gemini-3.6-flash",
  "small_model": "google-vertex/gemini-3.6-flash",
  "provider": {
    "google-vertex": {
      "options": {
        "project": "{env:OPENCODE_GCP_PROJECT}",
        "location": "global"
      }
    }
  },
  "autoupdate": "notify",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 300000
  },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "fkf": {
      "type": "local",
      "command": [
        "fkf",
        "mcp",
        "serve",
        "--base",
        "{{ env "FKF_BASE" | default (joinPath .chezmoi.homeDir "fmind/brain") }}"
      ],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      ".venv/**",
      "__pycache__/**",
      "node_modules/**"
    ]
  },
  "permission": "allow"
}
