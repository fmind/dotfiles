{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "dot agent hook notify grok needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "dot agent hook session grok",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "dot agent hook session grok",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "dot agent hook session grok",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "dot agent hook notify grok stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "dot agent hook session grok",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
