{{- /*
chezmoi:modify-template

Claude Code rewrites ~/.claude/settings.json in place: /model, /config, and the
effort picker all persist into this same file. Owning it as a plain source file
meant every `chezmoi apply --force` silently reverted those runtime choices
(effortLevel, the "opus[1m]" cache-TTL model suffix). Same shape as
dot_codex/modify_private_config.toml: the repo owns policy keys, the live file
keeps everything else, and seeds are written only when the key is still absent.
*/ -}}
{{- $currentConfig := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
{{-   $currentConfig = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- /* Kept pristine for the no-op guard below: the guard has to notice a
       retired key that pruning removes, or it would echo stdin back unchanged
       and the key would live forever. */ -}}
{{- $originalConfig := deepCopy $currentConfig -}}

{{- /* Settings Claude Code no longer reads. Preserving unknown keys is what
       keeps runtime state alive, so retired ones must be named explicitly or
       they linger forever, silently doing nothing. Verified against the
       installed binary: 2.x renamed maxSkillDescriptionChars to
       skillListingMaxDescChars (default 1536). */ -}}
{{- range $retired := list "maxSkillDescriptionChars" -}}
{{-   $_ := unset $currentConfig $retired -}}
{{- end -}}

{{- /* Seeded once on a fresh host, then owned by the runtime picker forever. */ -}}
{{- $seedConfig := dict
      "effortLevel" "xhigh"
      "model" "opus"
-}}

{{- $managedConfig := fromJson `{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactEnabled": true,
  "autoDreamEnabled": true,
  "autoMemoryEnabled": true,
  "autoUpdatesChannel": "stable",
  "awaySummaryEnabled": true,
  "cleanupPeriodDays": 30,
  "editorMode": "vim",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "1200000",
    "MAX_MCP_OUTPUT_TOKENS": "50000"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "feedbackSurveyRate": 0,
  "fileCheckpointingEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "precomputeCompactionEnabled": true,
  "promptSuggestionEnabled": false,
  "respondToBashCommands": true,
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "skillListingBudgetFraction": 0.02,
  "skillListingMaxDescChars": 3000,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "terminalProgressBarEnabled": true,
  "theme": "dark",
  "todoFeatureEnabled": true,
  "tui": "fullscreen",
  "verbose": true,
  "viewMode": "verbose",
  "worktree": {
    "baseRef": "head"
  }
}` -}}

{{- /* Hooks are built here rather than inlined so the shared session/notify
       pair stays readable and the ordering is stable across applies. Every
       Claude hook payload carries session_id/transcript_path/cwd, so
       `dot agent session claude` is valid on any of these events; it rewrites
       the normalized log from scratch each time, so extra firings only refresh.

       PreCompact matters most: compaction is the one point where transcript
       detail is discarded, and Stop alone can miss a long autonomous run that
       compacts before it ever returns to the prompt. */ -}}
{{- $hook := dict "type" "command" "timeout" 30 -}}
{{- $_ := set $managedConfig "hooks" (dict
      "SessionEnd" (list (dict "matcher" "" "hooks" (list
        (merge (dict "command" "dot agent session claude") $hook)
        (merge (dict "command" "dot notify claude session-end") $hook))))
      "Stop" (list (dict "matcher" "" "hooks" (list
        (merge (dict "command" "dot agent session claude") $hook)
        (merge (dict "command" "dot notify claude stop") $hook))))
      "SubagentStop" (list (dict "matcher" "" "hooks" (list
        (merge (dict "command" "dot agent session claude") $hook))))
      "PreCompact" (list (dict "matcher" "" "hooks" (list
        (merge (dict "command" "dot agent session claude") $hook))))
      "Notification" (list (dict "matcher" "" "hooks" (list
        (merge (dict "command" "dot notify claude needs-input") $hook))))
) -}}

{{- /* Agents roam outside the project root (workspaces brain, sibling repos),
       so grant them up front instead of tripping a prompt mid-run. */ -}}
{{- $_ = set (get $managedConfig "permissions") "additionalDirectories" (list
      (joinPath .chezmoi.homeDir ".agents")
      (joinPath .chezmoi.homeDir "externals")
      (joinPath .chezmoi.homeDir "internals")
      (joinPath .chezmoi.homeDir "workspaces")
) -}}

{{- $desiredConfig := mergeOverwrite $seedConfig (deepCopy $currentConfig) $managedConfig -}}
{{- if and (ne (trim .chezmoi.stdin) "") (deepEqual $originalConfig $desiredConfig) -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $desiredConfig | toPrettyJson }}
{{- end -}}
