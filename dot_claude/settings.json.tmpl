{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "opus",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactEnabled": true,
  "autoDreamEnabled": true,
  "autoMemoryEnabled": true,
  "autoUpdatesChannel": "stable",
  "awaySummaryEnabled": true,
  "cleanupPeriodDays": 30,
  "editorMode": "vim",
  "effortLevel": "xhigh",
  "enableAllProjectMcpServers": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "TASK_MAX_OUTPUT_LENGTH": "160000"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "feedbackSurveyRate": 0,
  "fileCheckpointingEnabled": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "dot agent hook notify claude needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "dot agent hook usage claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "dot agent hook usage claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "dot agent hook notify claude stop",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "dot agent hook usage claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "dot agent hook usage claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "opus[1m]",
  "permissions": {
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/.agents",
      "{{ .chezmoi.homeDir }}/.local/share/chezmoi",
      "{{ .chezmoi.homeDir }}/fmind",
      "{{ .chezmoi.homeDir }}/fmind-ai",
      "{{ .chezmoi.homeDir }}/mlops-courses"
    ],
    "defaultMode": "bypassPermissions"
  },
  "precomputeCompactionEnabled": true,
  "promptSuggestionEnabled": false,
  "respectGitignore": false,
  "respondToBashCommands": true,
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "skillListingBudgetFraction": 0.02,
  "skillListingMaxDescChars": 3000,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "statusLine": {"type": "command", "command": "jq -c '{recorded: now, model: .model.display_name, rate_limits}' | tee \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/usage.json\" | jq -r '\"\\(.model) | weekly tokens \\(.rate_limits.seven_day.used_percentage // \"?\")% used\"'"},
  "teammateDefaultModel": "sonnet",
  "teammateMode": "in-process",
  "terminalProgressBarEnabled": true,
  "theme": "dark",
  "todoFeatureEnabled": true,
  "tui": "fullscreen",
  "useAutoModeDuringPlan": true,
  "verbose": true,
  "viewMode": "verbose",
  "workflowKeywordTriggerEnabled": true,
  "worktree": {
    "baseRef": "head"
  }
}
