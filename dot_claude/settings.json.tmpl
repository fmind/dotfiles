{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactEnabled": true,
  "autoDreamEnabled": true,
  "autoMemoryEnabled": true,
  "autoUpdatesChannel": "stable",
  "awaySummaryEnabled": true,
  "cleanupPeriodDays": 30,
  "editorMode": "vim",
  "effortLevel": "high",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "MAX_MCP_OUTPUT_TOKENS": "50000"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "feedbackSurveyRate": 0,
  "fileCheckpointingEnabled": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "dot agent hook notify claude needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "dot agent hook notify claude stop",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/.agents",
      "{{ .chezmoi.homeDir }}/.local/share/chezmoi",
      "{{ .chezmoi.homeDir }}/externals",
      "{{ .chezmoi.homeDir }}/internals"
    ],
    "defaultMode": "bypassPermissions"
  },
  "precomputeCompactionEnabled": true,
  "promptSuggestionEnabled": false,
  "respondToBashCommands": true,
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "skillListingBudgetFraction": 0.02,
  "skillListingMaxDescChars": 3000,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "terminalProgressBarEnabled": true,
  "theme": "dark",
  "todoFeatureEnabled": true,
  "tui": "fullscreen",
  "verbose": true,
  "viewMode": "verbose",
  "worktree": {
    "baseRef": "head"
  }
}
