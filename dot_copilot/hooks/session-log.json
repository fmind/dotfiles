{
  "version": 1,
  "hooks": {
    "sessionEnd": [
      {
        "type": "command",
        "bash": "dot agent hook copilot-session-end",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "dot agent hook usage copilot",
        "timeoutSec": 10
      }
    ]
  }
}
